msgstr "заголовок"

msgid "%1$d / %2$d URLs queued."
msgstr "Добавлено в очередь: %1$d из %2$d URL."

msgid "Category job #%d queued."
msgstr "Задача категории #%d добавлена в очередь."

msgid "). Type \"update\", \"duplicate\", or \"skip\":"
msgstr "). Введите «update» (обновить), «duplicate» (дублировать) или «skip» (пропустить):"

